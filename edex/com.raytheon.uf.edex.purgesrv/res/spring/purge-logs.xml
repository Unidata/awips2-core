<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="purgeLogs" class="com.raytheon.uf.edex.purgesrv.PurgeLogs">
        <property name="logDirectory" value="${edex.home}/logs" />
        <property name="uncompressedDays" value="${purge.log.uncompressed.days}" />
        <property name="compressedDays" value="${purge.log.compressed.days}" />
    </bean>
    
    <bean id="purgeLogsContext" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.purgesrv.PurgeLogsContextRoutes">
                <constructor-arg name="purgeLogsCron" value="${purge.logs.cron}" />
            </bean>
        </constructor-arg>
    </bean>

</beans>