<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="localizationHttpSrv" class="com.raytheon.uf.edex.localization.http.LocalizationHttpService">
        <constructor-arg value="${edex.localization.http.path}" />
    </bean>

    <bean factory-bean="localizationHttpSrv" factory-method="register">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.localization.http.writer.zip.ZipArchiveResponseWriter" />
        </constructor-arg>
    </bean>

    <bean factory-bean="localizationHttpSrv" factory-method="register">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.localization.http.writer.json.JsonDirectoryListingWriter" />
        </constructor-arg>
    </bean>

    <bean factory-bean="localizationHttpSrv" factory-method="register">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.localization.http.writer.xml.XmlDirectoryListingWriter" />
        </constructor-arg>
    </bean>
    
    <bean id="localization-http-camel" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.localization.http.LocalizationHttpCamelRoutes">
                <constructor-arg name="httpPort" value="${HTTP_PORT}" />
                <constructor-arg name="edexLocalizationHttpPath" value="${edex.localization.http.path}" />
                <constructor-arg name="edexLocalizationHttpProperties" value="${edex.localization.http.properties}" />
            </bean>
        </constructor-arg>
    </bean>

</beans>