<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd
    http://camel.apache.org/schema/spring
    http://camel.apache.org/schema/spring/camel-spring.xsd">

    <bean factory-bean="handlerRegistry" factory-method="register">
        <constructor-arg value="com.raytheon.uf.common.serialization.comm.RemoteServiceRequest"/>
        <constructor-arg ref="serviceInterfaceHandler"/>
    </bean>

    <bean factory-bean="handlerRegistry" factory-method="register">
        <constructor-arg value="com.raytheon.uf.common.serialization.comm.DeflatedRequest"/>
        <constructor-arg ref="deflatedRequestHandler"/>
    </bean>

    <bean factory-bean="serverLocationRegistry" factory-method="register">
        <constructor-arg ref="requestServerKey" />
        <constructor-arg value="${HTTP_SERVER}" />
    </bean>
    
    <bean id="request-service-camel" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.requestsrv.RequestServiceCamelRoutes">
                <constructor-arg name="edexHttpPort" value="${edex.http.port}" />
                <constructor-arg name="edexHttpServerPath" value="${edex.http.server.path}" />
                <constructor-arg name="edexRequestSrvHttpChunked" value="${edex.requestsrv.http.chunked}" />    
            </bean>
        </constructor-arg>
    </bean>

</beans>
